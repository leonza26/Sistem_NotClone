<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to sensitive files
    <FilesMatch "^\.(env|git|htaccess|htpasswd|ini|log|sh)|composer\.(json|lock)|package\.(json|lock)|artisan$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Forward to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
